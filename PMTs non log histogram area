    TH1F *h_filled = (TH1F*)h_main->Clone("h_filled");
    for(int i=1; i<=h_filled->GetNbinsX(); i++) {
        if(h_filled->GetBinCenter(i) > 4800) {
            h_filled->SetBinContent(i, 0);
